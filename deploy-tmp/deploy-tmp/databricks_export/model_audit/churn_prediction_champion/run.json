      "freq_norm": "1 - total_transactions / max(total_transactions) [full-dataset max, pre-split]",
      "nps_norm": "1 - latest_nps_score.fillna(5) / 10.0"
    },
    "normalization_leakage": "max() values computed on FULL dataset before train/test split. Test labels are constructed using statistics derived from test rows.",
